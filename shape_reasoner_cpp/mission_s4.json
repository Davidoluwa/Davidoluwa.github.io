{
  "name": "SERA S4 neural proof kernel",
  "status": "research prototype; acceptance gate currently failed",
  "objective": "Learn reusable neural arithmetic transitions from raw input and compose them into explicit proof DAGs without token-autoregressive reasoning.",
  "implementation_language": "C++20",
  "prohibited_in_learner": [
    "operation IDs",
    "arithmetic primitives",
    "carry or borrow labels",
    "multiplication partial-product labels",
    "test-set labels or evaluator corrections",
    "transformer attention",
    "token autoregression"
  ],
  "learner_inputs": [
    "raw operand bits",
    "eight raw bits of the operator character",
    "bit-lattice boundary markers"
  ],
  "training_labels": [
    "result bits for complete arithmetic nodes"
  ],
  "acceptance_thresholds": {
    "atomic_in_domain_accuracy": 0.99,
    "atomic_magnitude_ood_accuracy": 0.95,
    "proof_final_accuracy": 0.95,
    "full_proof_accuracy": 0.95,
    "semantic_step_accuracy": 0.99,
    "local_step_accuracy": 0.99,
    "depth_4_6_final_accuracy": 0.90,
    "evaluation_parameter_drift": 0
  },
  "required_artifacts": [
    "training curve",
    "per-example atomic predictions",
    "per-depth proof metrics",
    "per-step proof ledger",
    "sample rendered proofs",
    "model parameter telemetry",
    "checkpoint and checksum",
    "input policy",
    "ablation table"
  ]
}
